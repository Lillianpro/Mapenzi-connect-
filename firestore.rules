rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidPhone(phone) {
      return phone is string && phone.size() >= 9 && phone.size() <= 20;
    }

    // User subscription & trial profile
    match /users/{phone} {
      allow read: if true;
      allow write: if isValidPhone(phone);
    }

    // Payment records
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['phone', 'amount', 'currency', 'provider', 'reference', 'status'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 1000;
      allow update, delete: if false;
    }
  }
}
